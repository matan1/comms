      202 +pub fn required_missing(                                      
      203 +    comms_dir: &Path,                                         
      204 +    cfg: &HarnessConfig,                                      
      205 +    rite: &Rite,                                              
      206 +) -> Vec<String> {                                            
      207 +    cfg.artifact_types                                        
      208 +        .iter()                                               
      209 +        .filter(|t| t.required_for.contains(&rite.name))      
      210 +        .filter(|t| {                                         
      211 +            let attested = type_targets(&t.name)              
      212 +                .iter()                                       
      213 +                .any(|target| attest_output(comms_dir, rite, t
          +arget).exists());                                             
      214 +            let waived = rite.allow_waivers && waiver_output(c
          +omms_dir, rite, &t.name).exists();                            
      215 +            !attested && !waived                              
      216 +        })                                                    
      217 +        .map(|t| t.name.clone())                              
      218 +        .collect()                                            
      219 +}                                                             
