          +s[0], &ExecInputs::default());                                
      760 +        assert!(bare.unwrap_err().contains("--body"));        
      761 +        let ask = ExecInputs { body: Some(b"may I read the let
          +ter?".to_vec()), ..Default::default() };                      
      762 +        execute_step(&comms, archive, &archive.steps[0], &ask)
          +.unwrap();                                                    
      763 +        let req_path = step_output(&comms, archive, &archive.s
          +teps[0]).unwrap();                                            
      764 +        let req = parse_attestation(&std::fs::read(&req_path).
          +unwrap()).unwrap();                                           
      765 +        assert_eq!(req.core.get("c").and_then(|c| c.get("kind"
          +)).and_then(Value::as_text),                                  
      766 +            Some("archive-request"));                         
      767 +                                                              
      768 +        // Grant is the counterparty's act: their key is requi
