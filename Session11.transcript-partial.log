      138 +/// The newest prior attestation of `target` already in the st
          +ore (any prior                                                
      139 +/// session), judged by frame `issued_at` — the link an entry 
          +attestation                                                   
      140 +/// records as its `previous-entry` ref. `exclude` is the curr
          +ent session's                                                 
      141 +/// own output path. None when this is the first of its kind. 
      142 +fn previous_attestation_id(comms_dir: &Path, target: &str, exc
          +lude: &Path) -> Option<String> {                              
      143 +    let store = comms_dir.join("store");                      
      144 +    let prefix = format!("{target}.");                        
      145 +    let mut best: Option<(String, String)> = None; // (issued_
          +at, id)                                                       
      146 +    for entry in std::fs::read_dir(&store).ok()?.flatten() {  
      147 +        let p = entry.path();                                 
      148 +        if p == exclude {                                     
      149 +            continue;                                         
      150 +        }                                                     
      151 +        let Some(name) = p.file_name().and_then(|n| n.to_str()
          +) else { continue };                                          
      152 +        if !name.ends_with(".cbor") || !(name.starts_with(&pre
          +fix) || name == format!("{target}.cbor")) {                   
      153 +            continue;                                         
      154 +        }                                                     
      155 +        let Ok(bytes) = std::fs::read(&p) else { continue };  
      156 +        let Ok(att) = parse_attestation(&bytes) else { continu
          +e };                                                          
      157 +        let issued = att                                      
      158 +            .core                                             
      159 +            .get("f")                                         
      160 +            .and_then(|f| f.get("issued_at"))                 
      161 +            .and_then(crate::cbor::Value::as_text)            
      162 +            .unwrap_or("")                                    
      163 +            .to_owned();                                      
      164 +        let id = att.id();                                    
      165 +        if best.as_ref().map(|(t, _)| issued > *t).unwrap_or(t
          +rue) {                                                        
      166 +            best = Some((issued, id));                        
      167 +        }                                                     
      168 +    }                                                         
      169 +    best.map(|(_, id)| id)                                    
      170 +}                                                             
