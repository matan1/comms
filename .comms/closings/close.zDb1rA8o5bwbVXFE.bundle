      852 +    let store = o                                             
      853 +        .get("--store")                                       
      854 +        .map(std::path::PathBuf::from)                        
      855 +        .unwrap_or_else(|| pending.parent().unwrap_or(std::pat
          +h::Path::new(".")).join("store"));                            
      856 +                                                              
      857 +    let outcomes =                                            
