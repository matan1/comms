          +me("session".to_owned()) }],                                  
      242 +        allow_waivers: false,                                 
      243 +    };                                                        
      244 +    let sk = session_signer(comms_dir, &rite)?;               
      245 +    let now = now_rfc3339();                                  
      246 +    let spec = ClaimSpec {                                    
      247 +        about: type_name,                                     
      248 +        kind: "waiver",                                       
      249 +        body,                                                 
      250 +        media_type: "text/markdown",                          
      251 +        support: &[],                                         
      252 +        language: "zxx",                                      
      253 +        community: None,                                      
      254 +        occasion: Some("waiver"),                             
      255 +        issued_at: &now,                                      
      256 +    };                                                        
      257 +    let att = author_general_claim(&spec, &sk, "author", &now)
          +;                                                             
      258 +    let out = waiver_output(comms_dir, &rite, type_name);     
      259 +    std::fs::create_dir_all(out.parent().unwrap())            
      260 +        .map_err(|e| format!("{}: {e}", out.parent().unwrap().
          +display()))?;                                                 
      261 +    std::fs::write(&out, att.to_cbor()).map_err(|e| format!("{
          +}: {e}", out.display()))?;                                    
      262 +    Ok(ExecOutcome {                                          
      263 +        message: format!("recorded waiver of '{type_name}' {} 
          +-> {}", att.id(), out.display()),                             
      264 +        output: Some(out),                                    
      265 +        secret: None,                                         
      266 +    })                                                        
      267 +}                                                             
