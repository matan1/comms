      449 +                None => BodyStatus::Absent,                   
      450 +                Some(blob) => {                               
      451 +                    if blake3::hash(blob).as_bytes() == &hash 
          +&& blob.len() as u64 == len {                                 
      452 +                        BodyStatus::Verified                  
      453 +                    } else {                                  
      454 +                        BodyStatus::Mismatched                
      455 +                    }                                         
      456 +                }                                             
      457 +            };                                                
      458 +            ContentReport::Detached { body_b3: hash, body_len:
          + len, status }                                                
      459 +        }                                                     
      460 +    }                                                         
      461 +}                                                             
