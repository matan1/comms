       97 +                                                              
       98 +/// Where a `countersign` step stages its pending item.       
       99 +fn countersign_output(comms_dir: &Path, rite: &Rite) -> PathBu
          +f {                                                           
      100 +    let name = match session_tag(comms_dir, rite) {           
      101 +        Some(tag) => format!("countersign.{tag}.cbor"),       
      102 +        None => "countersign.cbor".to_owned(),                
      103 +    };                                                        
      104 +    pending_dir(comms_dir).join(name)                         
      105 +}                                                             
      106 +                                                              
      107 +/// Where a `request`/`grant` step writes its attestation. Pre
          +fixed by the verb                                             
      108 +/// (a request and its decision must not collide) and session-
          +scoped like every                                             
      109 +/// other attest output.                                      
      110 +fn decision_output(comms_dir: &Path, rite: &Rite, verb: &str, 
          +target: &str) -> PathBuf {                                    
      111 +    let stem = if verb == "grant" { "decision" } else { verb }
          +;                                                             
      112 +    let name = match session_tag(comms_dir, rite) {           
      113 +        Some(tag) => format!("{stem}.{target}.{tag}.cbor"),   
      114 +        None => format!("{stem}.{target}.cbor"),              
      115 +    };                                                        
      116 +    comms_dir.join("store").join(name)                        
      117 +}                                                             
      118 +                                                              
      119  /// Where a step's product lands on disk, if it has one.
      120  pub fn step_output(comms_dir: &Path, rite: &Rite, step: &Step)
            -> Option<PathBuf> {
      121      let target = step.target.as_deref();
     ...
      123          "mint" | "shred" => Some(key_path(comms_dir, target.un
           wrap_or("session"))),
      124          "attest" => Some(attest_output(comms_dir, rite, target
           .unwrap_or("entry"))),
      125          "seal" | "pack" => Some(bundle_output(comms_dir, rite)
           ),
      126 +        "countersign" => Some(countersign_output(comms_dir, ri
          +te)),                                                         
      127 +        "request" | "grant" => {                              
      128 +            Some(decision_output(comms_dir, rite, &step.verb, 
          +target.unwrap_or("archive")))                                 
      129 +        }                                                     
      130          _ => None,
      131      }
      132  }
      133  
      134 +/// Has the configured countersigner's endorsement of this ses
          +sion's key                                                    
      135 +/// reached the store? Checked by claim content, not filename,
          + so it holds                                                  
      136 +/// however the finalized attestation arrived.                
      137 +fn countersign_recorded(comms_dir: &Path, rite: &Rite) -> bool
          + {                                                            
      138 +    let Some(session_id) = session_id(comms_dir, rite) else { 
      139 +        return false;                                         
      140 +    };                                                        
      141 +    let store = comms_dir.join("store");                      
      142 +    let Ok(entries) = std::fs::read_dir(&store) else {        
      143 +        return false;                                         
      144 +    };                                                        
      145 +    for e in entries.filter_map(|e| e.ok()) {                 
      146 +        let p = e.path();                                     
      147 +        if p.extension().map(|x| x != "cbor").unwrap_or(true) 
          +{                                                             
      148 +            continue;                                         
      149 +        }                                                     
      150 +        let Ok(bytes) = std::fs::read(&p) else { continue };  
      151 +        let Ok(att) = parse_attestation(&bytes) else { continu
          +e };                                                          
      152 +        let claim = att.core.get("c");                        
      153 +        let is_endorsement = claim                            
      154 +            .and_then(|c| c.get("t"))                         
      155 +            .and_then(Value::as_text)                         
      156 +            .map(|t| t == "endorsement/1")                    
      157 +            .unwrap_or(false);                                
      158 +        let targets_session = claim                           
      159 +            .and_then(|c| c.get("target"))                    
      160 +            .and_then(Value::as_text)                         
      161 +            .map(|t| t == session_id)                         
      162 +            .unwrap_or(false);                                
      163 +        if is_endorsement && targets_session && !att.signature
          +s.is_empty() {                                                
      164 +            return true;                                      
      165 +        }                                                     
      166 +    }                                                         
      167 +    false                                                     
      168 +}                                                             
      169 +                                                              
      170  /// Is this step satisfied by what's on disk?
      171  pub fn step_done(comms_dir: &Path, rite: &Rite, step: &Step) -
           > bool {
      172      match step_output(comms_dir, rite, step) {
      173          // shred's goal is the seed's *absence*.
      174          Some(out) if step.verb == "shred" => !out.exists(),
      175 +        // countersign is done once staged (the counterparty's
          + signature is                                                 
      176 +        // their act, tracked as an outstanding need) — or onc
          +e their                                                       
      177 +        // endorsement has been finalized into the store and s
          +taging cleared.                                               
      178 +        Some(out) if step.verb == "countersign" => {          
      179 +            out.exists() || countersign_recorded(comms_dir, ri
          +te)                                                           
      180 +        }                                                     
      181          Some(out) => out.exists(),
      182          None => false,
      183      }

