      30 +/// RFC 3339 UTC from a unix timestamp (see [`now_rfc3339`]).  
      31 +pub fn rfc3339_from_unix(secs: u64) -> String {                
      32      let days = (secs / 86400) as i64;
      33      let rem = secs % 86400;
      34      let (hh, mm, ss) = (rem / 3600, (rem % 3600) / 60, rem % 60
          );

