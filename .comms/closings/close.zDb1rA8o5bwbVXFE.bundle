      171  pub fn step_done(comms_dir: &Path, rite: &Rite, step: &Step) -
           > bool {
      172      match step_output(comms_dir, rite, step) {
      173          // shred's goal is the seed's *absence*.
      174          Some(out) if step.verb == "shred" => !out.exists(),
      175 +        // countersign is done once staged (the counterparty's
          + signature is                                                 
      176 +        // their act, tracked as an outstanding need) — or onc
          +e their                                                       
      177 +        // endorsement has been finalized into the store and s
          +taging cleared.                                               
      178 +        Some(out) if step.verb == "countersign" => {          
      179 +            out.exists() || countersign_recorded(comms_dir, ri
          +te)                                                           
      180 +        }                                                     
      181          Some(out) => out.exists(),
      182          None => false,
      183      }

