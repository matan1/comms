       84 +def body_status(content: dict, data: bytes | None = None) -> s
          +tr:                                                           
       85 +    """A2.2 body status — a judgment separate from attestation
          + validity:                                                    
       86 +                                                              
       87 +    - "verified":   bytes at hand honor the commitment (an emb
          +edded body is                                                 
       88 +                    trivially verified — the bytes are the com
          +mitment)                                                      
       89 +    - "absent":     detached and no bytes at hand; the normal 
          +state for                                                     
       90 +                    anything host-gated, never an error       
       91 +    - "mismatched": bytes at hand under the body's name, but h
          +ash or length                                                 
       92 +                    differs; per the preservation stance such 
          +bytes are                                                     
       93 +                    retained and reported, never deleted or si
          +lently repaired                                               
       94 +                                                              
       95 +    Callers must not fold "absent"/"mismatched" into signature
          + failure.                                                     
       96 +    """                                                       
       97 +    from .canonical import blake3_hash                        
       98 +                                                              
       99 +    if "body" in content:                                     
      100 +        return "verified"                                     
      101 +    if data is None:                                          
      102 +        return "absent"                                       
      103 +    if blake3_hash(data) == content.get("body_b3") \          
      104 +            and len(data) == content.get("body_len"):         
      105 +        return "verified"                                     
      106 +    return "mismatched"                                       
