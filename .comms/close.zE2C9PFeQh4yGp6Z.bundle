{"timestamp":"2026-07-06T17:07:29.551Z","type":"response_item","payload":{"type":"function_call_output","call_id":"call_fLzqfVtUNe5lIVvRbdLJxkRZ","output":"Chunk ID: 0219ea\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 1231\nOutput:\n         \\x20         [--media-type T] [--language L] [--community C] [--occasion O]\\n\\\n         \\x20         [--role R] [--support ID]... [--out FILE]   author + sign a\\n\\\n         \\x20         general-claim/1 (--detach commits to the body without carrying it)\\n\\\n         \\x20 status  [dir] [--json]           where you are in the rite + next step\\n\\\n         \\x20 next    [dir] [--rite N] [--body F] [--about S]   perform the next step\\n\\\n         \\x20 verify  <bundle>                 check the A1.8 integrity seal (default)\\n\\\n         \\x20 inspect <bundle> [--json]        verify every member on its own terms\\n\\\n         \\x20 seal    <bundle> --key <k> [--out <p>] [--description S] [--*-at T]\\n\\\n         \\x20 pack    --out <bundle> <att.cbor|dir>... [--media F]... [--seal --key <k>]\\n\\\n         \\x20 extract <bundle> --out <dir>     write members and media to files\\n\\\n         \\x20 intake  <bundle|dir> [root] --key <k> [--legacy --provenance S]\\n\\\n         \\x20         host/archive side: verify, ingest by id/hash, regenerate\\n\\\n         \\x20         undurable views, attest custody (idempotent)\\n\\\n         \\x20 audit   [root]                   re-derive every id and hash in custody;\\n\\\n         \\x20         mark drift, never delete; suggest custody testimony\\n\\\n         \\x20 mint    --out <key.json> [--label L]   generate a steward key for sealing\\n\\\n         \\x20 waive   <type> [dir] --body <reason>   record that this session cannot\\n\\\n         \\x20         produce a required artifact (the gap becomes an attestation)\\n\\\n         \\x20 sign    --key <openssh|steward-key> [--pending DIR]   countersign staged\\n\\\n         \\x20         pending items (the counterparty's half of a rite)\\n\\\n         \\x20 finalize [--pending DIR] [--store DIR]  verify + move fully-signed\\n\\\n         \\x20         pending items into the store\\n\\\n         \\x20 vouch   <bundle> --policy ID --subject ID --purpose S --as-of T [--json]\\n\\\n         \\x20         [--community ID] [--receipt-out P --key K]\\n\\\n        \"status\" => \"comms status [dir] [--json]\\n  Report where you are in each rite and the exact next command.\\n\",\n        \"next\" => \"comms next [dir] [--rite N] [--body F] [--about S] [--kind K]\\n  Perform the next pending step of a rite. attest steps need --body;\\n  with no --rite, advances the rite you are currently in.\\n\",\n        \"verify\" => \"comms verify <bundle>\\n  Check the A1.8 integrity seal (also the default for a bare bundle path).\\n\",\n        \"seal\" => \"comms seal <bundle> --key <k.json> [--out P] [--description S] [--created-at T] [--issued-at T] [--signed-at T]\\n  Add an A1.8 integrity seal (signs the exact member set).\\n\",\n        \"pack\" => \"comms pack --out <bundle> [<att.cbor|dir>...] [--media F]... [--seal --key <k.json>] [--description S]\\n  Gather attestations and/or media blobs into a bundle.\\n\",\n        \"extract\" => \"comms extract <bundle> --out <dir>\\n  Write each member <id>.cbor and media blob to disk.\\n\",\n        \"intake\" => \"comms intake <bundle|file|dir> [archive-root] --key <custodian key> \\\\\\n    [--legacy --provenance \\\"...\\\"]\\n  Host/archive-side crossing: verify a sealed session bundle, ingest members by\\n  id and bodies by hash (idempotent), regenerate undurable views/ for browsing,\\n  and attest custody. --legacy takes unattested material in as testimony, by\\n  hash, honestly labeled.\\n\",\n        \"audit\" => \"comms audit [archive-root]\\n  Host/archive-side custody check: walk store/ and bodies/, re-derive every id\\n  and hash, and report intact / absent / mismatched. Drift is marked, never\\n  deleted. On drift, audit should propose a reviewed custody attestation draft.\\n\",\n        \"mint\" => \"comms mint --out <key.json> [--label L]\\n  Generate a steward key ({seed_b58, label} JSON, mode 0600).\\n\",\n        \"waive\" => \"comms waive <type> [dir] --body <reason file|->\\n  Record a session-signed waiver: this session cannot produce a declared\\n  `required_for` artifact, and says so on the record instead of being blocked.\\n  Only rites with `allow_waivers = true` accept it at seal.\\n\",\n        \"sign\" => \"comms sign --key <path> [--pending DIR]\\n  Countersign staged pending items (<name>.cbor + <name>.needs.json) with an\\n  OpenSSH ed25519 key or a steward key file. Needs naming other keys are left\\n  standing. Default DIR: .comms/pending or continuity/pending, whichever has\\n  staged items.\\n\",\n        \"finalize\" => \"comms finalize [--pending DIR] [--store DIR]\\n  Verify every fully-signed pending item and move it into the store under its\\n  content id. Aborts loudly if anything is unsigned or invalid. Default store:\\n  the sibling store/ of the pending directory.\\n\",\n        \"vouch\" => \"comms vouch <bundle> --policy ID --subject ID --purpose S --as-of T [--json] [--community ID] [--receipt-out P --key K]\\n  Policy-relative evaluation: a viewer's judgment, not proof.\\n\",\n        _ => return usage_text(),\n    };\n    synopsis.to_owned()\n"}}
