      791 +/// Default pending directory: whichever known location holds 
          +staged items.                                                 
      792 +/// Ambiguity (both do) demands an explicit --pending rather t
          +han a guess.                                                  
      793 +fn resolve_pending_dir(explicit: Option<&str>) -> std::path::P
          +athBuf {                                                      
      794 +    if let Some(p) = explicit {                               
      795 +        return std::path::PathBuf::from(p);                   
      796 +    }                                                         
      797 +    let candidates = [".comms/pending", "continuity/pending"];
      798 +    let with_items: Vec<&str> = candidates                    
      799 +        .iter()                                               
      800 +        .copied()                                             
      801 +        .filter(|d| {                                         
      802 +            std::fs::read_dir(d)                              
      803 +                .map(|rd| {                                   
      804 +                    rd.filter_map(|e| e.ok())                 
      805 +                        .any(|e| e.file_name().to_string_lossy
          +().ends_with(".needs.json"))                                  
      806 +                })                                            
      807 +                .unwrap_or(false)                             
      808 +        })                                                    
      809 +        .collect();                                           
      810 +    match with_items.as_slice() {                             
      811 +        [one] => std::path::PathBuf::from(one),               
      812 +        [] => die("no staged pending items in .comms/pending o
          +r continuity/pending (pass --pending DIR)"),                  
      813 +        _ => die("staged items in both .comms/pending and cont
          +inuity/pending — pass --pending DIR"),                        
      814 +    }                                                         
      815 +}                                                             
