      817 +fn cmd_sign(args: &[String]) {                                
      818 +    let o = parse_opts(args);                                 
      819 +    let key = o.require("--key");                             
      820 +    let pending = resolve_pending_dir(o.get("--pending"));    
      821 +    let sk = comms_core::signing::load_signing_key(std::path::
          +Path::new(key))                                               
      822 +        .unwrap_or_else(|e| die(e));                          
      823 +    let signer = personal_steward_id(sk.verifying_key().as_byt
          +es());                                                        
      824 +    println!("signing as {signer}");                          
      825 +                                                              
      826 +    let outcomes = comms_core::signing::sign_pending(&pending,
          + &sk).unwrap_or_else(|e| die(e));                             
      827 +    if outcomes.is_empty() {                                  
      828 +        println!("nothing pending in {}", pending.display()); 
      829 +        return;                                               
      830 +    }                                                         
      831 +    let mut outstanding = 0;                                  
      832 +    for oc in &outcomes {                                     
      833 +        for role in &oc.signed_roles {                        
      834 +            println!("  {}: signed as {role}", oc.stem);      
      835 +        }                                                     
      836 +        for need in &oc.skipped {                             
      837 +            println!("  {}: still needs {} as {} (not this key
          +)", oc.stem, need.by, need.role);                             
      838 +            outstanding += 1;                                 
      839 +        }                                                     
      840 +        if oc.signed_roles.is_empty() && oc.skipped.is_empty()
          + {                                                            
      841 +            println!("  {}: fully signed already", oc.stem);  
      842 +        }                                                     
      843 +    }                                                         
      844 +    if outstanding == 0 {                                     
      845 +        println!("\nnext — seal what is signed:  comms finaliz
          +e --pending {}", pending.display());                          
      846 +    }                                                         
      847 +}                                                             
      848 +                                                              
      849 +fn cmd_finalize(args: &[String]) {                            
      850 +    let o = parse_opts(args);                                 
