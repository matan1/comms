4\t            let name = p\n   535\t                .file_name()\n   536\t                .unwrap_or_default()\n   537\t                .to_string_lossy()\n   538\t                .into_owned();\n   539\t            let Ok(bytes) = std::fs::read(&p) else {\n   540\t                report.store_drift.push((name, \"unreadable\".to_owned()));\n   541\t                continue;\n   542\t            };\n   543\t            let att = match parse_attestation(&bytes) {\n   544\t                Ok(a) => a,\n   545\t                Err(e) => {\n   546\t                    report\n   547\t                        .store_drift\n   548\t                        .push((name, format!(\"does not parse: {e} — retained\")));\n   549\t                    continue;\n   550\t                }\n"}}
