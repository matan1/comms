      410 +pub fn content_report(att: &Attestation, bodies: &HashMap<Stri
          +ng, Vec<u8>>) -> ContentReport {                              
      411 +    let Some(claim) = att.core.get("c") else { return ContentR
          +eport::None };                                                
      412 +    if claim.get("t").and_then(Value::as_text) != Some("genera
          +l-claim/1") {                                                 
      413 +        return ContentReport::None;                           
      414 +    }                                                         
      415 +    let Some(content) = claim.get("content") else {           
      416 +        return ContentReport::Malformed("general-claim carries
          + no content map".to_owned());                                 
      417 +    };                                                        
      418 +    let body = content.get("body");                           
      419 +    let body_b3 = content.get("body_b3");                     
      420 +    match (body, body_b3) {                                   
      421 +        (Some(_), Some(_)) => {                               
      422 +            ContentReport::Malformed("content carries both bod
          +y and body_b3 (A2.1)".to_owned())                             
      423 +        }                                                     
      424 +        (None, None) => {                                     
      425 +            ContentReport::Malformed("content carries neither 
          +body nor body_b3 (A2.1)".to_owned())                          
      426 +        }                                                     
      427 +        (Some(b), None) => {                                  
      428 +            let Some(bytes) = b.as_bytes() else {             
