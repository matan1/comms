      176 +/// Where a recorded waiver for an artifact type lands. Sessio
          +n-scoped like                                                 
      177 +/// every other attest output.                                
      178 +fn waiver_output(comms_dir: &Path, rite: &Rite, type_name: &st
          +r) -> PathBuf {                                               
      179 +    let name = match session_tag(comms_dir, rite) {           
      180 +        Some(tag) => format!("waiver.{type_name}.{tag}.cbor"),
      181 +        None => format!("waiver.{type_name}.cbor"),           
      182 +    };                                                        
      183 +    comms_dir.join("store").join(name)                        
      184 +}                                                             
      185 +                                                              
      186 +/// The attest target an artifact type's presence is checked u
          +nder: rite steps                                              
      187 +/// say `attest transcript` while the type is declared `[artif
          +act_types.transcripts]`,                                      
      188 +/// so the singular form is tried alongside the declared name.
      189 +fn type_targets(type_name: &str) -> Vec<String> {             
      190 +    let mut t = vec![type_name.to_owned()];                   
      191 +    if let Some(singular) = type_name.strip_suffix('s') {     
      192 +        if !singular.is_empty() {                             
      193 +            t.push(singular.to_owned());                      
      194 +        }                                                     
      195 +    }                                                         
      196 +    t                                                         
      197 +}                                                             
      198 +                                                              
      199 +/// Declared-but-absent artifact types for a rite: those whose
          + `required_for`                                               
      200 +/// names it and for which this session's store holds neither 
          +an attested                                                   
      201 +/// artifact nor (when the rite allows them) a recorded waiver
          +.                                                             
      202 +pub fn required_missing(                                      
      203 +    comms_dir: &Path,                                         
      204 +    cfg: &HarnessConfig,                                      
      205 +    rite: &Rite,                                              
      206 +) -> Vec<String> {                                            
      207 +    cfg.artifact_types                                        
      208 +        .iter()                                               
      209 +        .filter(|t| t.required_for.contains(&rite.name))      
      210 +        .filter(|t| {                                         
      211 +            let attested = type_targets(&t.name)              
      212 +                .iter()                                       
      213 +                .any(|target| attest_output(comms_dir, rite, t
          +arget).exists());                                             
      214 +            let waived = rite.allow_waivers && waiver_output(c
          +omms_dir, rite, &t.name).exists();                            
      215 +            !attested && !waived                              
      216 +        })                                                    
      217 +        .map(|t| t.name.clone())                              
      218 +        .collect()                                            
      219 +}                                                             
      220 +                                                              
      221 +/// Record a session-signed waiver for an artifact type this s
          +ession cannot                                                 
      222 +/// produce. The waiver is an attestation like anything else: 
          +the gap in the                                                
      223 +/// record is itself recorded, not papered over.              
      224 +pub fn record_waiver(                                         
      225 +    comms_dir: &Path,                                         
      226 +    cfg: &HarnessConfig,                                      
      227 +    type_name: &str,                                          
      228 +    body: &[u8],                                              
      229 +) -> Result<ExecOutcome, String> {                            
      230 +    if cfg.artifact_type(type_name).is_none() {               
      231 +        let declared: Vec<_> = cfg.artifact_types.iter().map(|
          +t| t.name.as_str()).collect();                                
      232 +        return Err(format!(                                   
      233 +            "no artifact type '{type_name}' declared in comms.
          +toml (declared: {})",                                         
      234 +            declared.join(", ")                               
      235 +        ));                                                   
      236 +    }                                                         
      237 +    // Waivers are session acts; scope them via the convention
          +al session rite                                               
      238 +    // shape so the tag matches every other artifact of this s
          +ession.                                                       
      239 +    let rite = Rite {                                         
