          +display()))?;                                                 
      261 +    std::fs::write(&out, att.to_cbor()).map_err(|e| format!("{
          +}: {e}", out.display()))?;                                    
      262 +    Ok(ExecOutcome {                                          
      263 +        message: format!("recorded waiver of '{type_name}' {} 
          +-> {}", att.id(), out.display()),                             
      264 +        output: Some(out),                                    
      265 +        secret: None,                                         
      266 +    })                                                        
      267 +}                                                             
