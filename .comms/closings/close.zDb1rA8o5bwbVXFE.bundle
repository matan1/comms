          +act_types.transcripts]`,                                      
      188 +/// so the singular form is tried alongside the declared name.
      189 +fn type_targets(type_name: &str) -> Vec<String> {             
      190 +    let mut t = vec![type_name.to_owned()];                   
      191 +    if let Some(singular) = type_name.strip_suffix('s') {     
      192 +        if !singular.is_empty() {                             
      193 +            t.push(singular.to_owned());                      
      194 +        }                                                     
      195 +    }                                                         
      196 +    t                                                         
      197 +}                                                             
