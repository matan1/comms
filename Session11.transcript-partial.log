      440 +                return ContentReport::Malformed("body_b3 is no
          +t 32 bytes (A2.1)".to_owned());                               
      441 +            };                                                
      442 +            let Some(len) = content.get("body_len").and_then(V
          +alue::as_u64) else {                                          
      443 +                return ContentReport::Malformed(              
      444 +                    "detached content requires body_len (A2.1)
          +".to_owned(),                                                 
      445 +                );                                            
      446 +            };                                                
      447 +            let key = format!("z{}", bs58::encode(hash).into_s
          +tring());                                                     
