       61 +/// The environment variable an ephemeral session's holder sup
          +plies the seed in.                                            
       62 +pub const SEED_ENV: &str = "COMMS_SESSION_SEED";              
       63 +                                                              
       64 +/// Decode a base58 32-byte seed into a signing key.          
       65 +fn seed_from_b58(b58: &str) -> Result<ed25519_dalek::SigningKe
          +y, String> {                                                  
       66 +    let seed = bs58::decode(b58.trim())                       
       67 +        .into_vec()                                           
       68 +        .map_err(|e| format!("{SEED_ENV} is not base58: {e}"))
          +?;                                                            
       69 +    let seed: [u8; 32] = seed                                 
       70 +        .as_slice()                                           
       71 +        .try_into()                                           
       72 +        .map_err(|_| format!("{SEED_ENV} is not a 32-byte seed
          +"))?;                                                         
       73 +    Ok(ed25519_dalek::SigningKey::from_bytes(&seed))          
       74 +}                                                             
       75 +                                                              
       76 +/// Does the holder's environment carry the seed for *this* se
          +ssion (the one                                                
       77 +/// named by the on-disk session id)? A seed for some other se
          +ssion does not                                                
       78 +/// count: the id derived from it must match.                 
       79 +fn env_seed_matches(comms_dir: &Path, rite: &Rite) -> bool {  
       80 +    let Some(sid) = session_id(comms_dir, rite) else {        
       81 +        return false;                                         
       82 +    };                                                        
       83 +    let Ok(b58) = std::env::var(SEED_ENV) else {              
       84 +        return false;                                         
       85 +    };                                                        
       86 +    seed_from_b58(&b58)                                       
       87 +        .map(|sk| personal_steward_id(sk.verifying_key().as_by
          +tes()) == sid)                                                
       88 +        .unwrap_or(false)                                     
       89 +}                                                             
       90 +                                                              
       91 +/// The signing key of the live session: the on-disk key file 
          +if present, else                                              
       92 +/// a seed the holder supplies through the environment — which
          + must derive the                                              
       93 +/// on-disk session id, so nobody quietly signs as a different
          + steward.                                                     
       94 +fn session_signer(comms_dir: &Path, rite: &Rite) -> Result<ed2
          +5519_dalek::SigningKey, String> {                             
       95 +    let kp = key_path(comms_dir, &session_target(rite));      
       96 +    if kp.exists() {                                          
       97 +        return keyfile::load(&kp);                            
       98 +    }                                                         
       99 +    let Ok(b58) = std::env::var(SEED_ENV) else {              
      100 +        return Err(format!(                                   
      101 +            "no session key at {} and {SEED_ENV} is not set — 
          +mint first (or export \                                       
      102 +             the seed you were shown at mint)",               
      103 +            kp.display()                                      
      104 +        ));                                                   
      105 +    };                                                        
      106 +    let sk = seed_from_b58(&b58)?;                            
      107 +    let id = personal_steward_id(sk.verifying_key().as_bytes()
          +);                                                            
      108 +    match session_id(comms_dir, rite) {                       
      109 +        Some(sid) if sid == id => Ok(sk),                     
      110 +        Some(sid) => Err(format!(                             
      111 +            "{SEED_ENV} derives {id}, but the session on recor
          +d is {sid} — refusing to \                                    
      112 +             sign as a different steward"                     
      113 +        )),                                                   
      114 +        None => Err("no session on record — mint first".to_own
          +ed()),                                                        
      115 +    }                                                         
      116 +}                                                             
