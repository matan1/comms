      749 +                                                              
      750 +    #[test]                                                   
      751 +    fn request_then_grant_records_decision_with_ref() {       
      752 +        let comms = scratch("reqgrant");                      
      753 +        let (cfg, _guardian, gid) = cs_setup(&comms);         
      754 +        let open = cfg.rite("open").unwrap();                 
      755 +        let archive = cfg.rite("archive").unwrap();           
      756 +        execute_step(&comms, open, &open.steps[0], &ExecInputs
          +::default()).unwrap();                                        
      757 +                                                              
      758 +        // The ask must be in writing.                        
      759 +        let bare = execute_step(&comms, archive, &archive.step
          +s[0], &ExecInputs::default());                                
      760 +        assert!(bare.unwrap_err().contains("--body"));        
      761 +        let ask = ExecInputs { body: Some(b"may I read the let
          +ter?".to_vec()), ..Default::default() };                      
      762 +        execute_step(&comms, archive, &archive.steps[0], &ask)
          +.unwrap();                                                    
      763 +        let req_path = step_output(&comms, archive, &archive.s
          +teps[0]).unwrap();                                            
      764 +        let req = parse_attestation(&std::fs::read(&req_path).
          +unwrap()).unwrap();                                           
      765 +        assert_eq!(req.core.get("c").and_then(|c| c.get("kind"
          +)).and_then(Value::as_text),                                  
      766 +            Some("archive-request"));                         
      767 +                                                              
      768 +        // Grant is the counterparty's act: their key is requi
          +red.                                                          
      769 +        let keyless = execute_step(&comms, archive, &archive.s
          +teps[1], &ExecInputs::default());                             
      770 +        assert!(keyless.unwrap_err().contains("--key"));      
      771 +                                                              
      772 +        // A decline is recorded the same way as a grant — a d
          +ecision, not a failure.                                       
      773 +        let decide = ExecInputs {                             
      774 +            key: Some(comms.join("guardian.json")),           
      775 +            decision: Some("decline"),                        
      776 +            ..Default::default()                              
      777 +        };                                                    
      778 +        execute_step(&comms, archive, &archive.steps[1], &deci
          +de).unwrap();                                                 
      779 +        assert!(rite_view(&comms, archive).complete());       
      780 +                                                              
      781 +        let dec_path = step_output(&comms, archive, &archive.s
          +teps[1]).unwrap();                                            
      782 +        let dec = parse_attestation(&std::fs::read(&dec_path).
          +unwrap()).unwrap();                                           
      783 +        let claim = dec.core.get("c").unwrap();               
      784 +        assert_eq!(claim.get("kind").and_then(Value::as_text),
          + Some("archive-decline"));                                    
      785 +        assert_eq!(claim.get("support").and_then(Value::as_arr
          +ay).map(|a| a.len()), Some(1));                               
      786 +        assert_eq!(claim.get("support").and_then(|s| s.get(0))
          +.and_then(Value::as_text),                                    
      787 +            Some(req.id().as_str()));                         
      788 +        assert_eq!(dec.signatures[0].by, gid);                
      789 +        assert_eq!(dec.signatures[0].role, "custodian");      
      790 +    }                                                         
      791  }

