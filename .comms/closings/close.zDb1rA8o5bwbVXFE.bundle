      752 +        let comms = scratch("reqgrant");                      
      753 +        let (cfg, _guardian, gid) = cs_setup(&comms);         
      754 +        let open = cfg.rite("open").unwrap();                 
      755 +        let archive = cfg.rite("archive").unwrap();           
